<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121824"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BYD Voice Assistant Settings"
            android:textColor="#00E5FF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Offline Hybrid Voice Configuration for DiLink"
            android:textColor="#8892B0"
            android:textSize="14sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="16dp"
            android:background="#233554" />

        <!-- Section 1: Engine B (llama.cpp GGUF Model) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Engine B: Tiny LLM (.gguf)"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSelectedGguf"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="No .gguf model selected (using built-in fallback)"
            android:textColor="#A8B2D1"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnSelectGguf"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="#0D47A1"
            android:text="Select .gguf Model File"
            android:textColor="#FFFFFF" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="16dp"
            android:background="#233554" />

        <!-- Section 2: Piper TTS Model -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Piper TTS: VITS Model (.onnx)"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSelectedPiper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="No Piper model selected (using Android system TTS)"
            android:textColor="#A8B2D1"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnSelectPiper"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="#0D47A1"
            android:text="Select Piper .onnx Model File"
            android:textColor="#FFFFFF" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="16dp"
            android:background="#233554" />

        <!-- Section 3: Engine Diagnostics -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="System Diagnostics"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvEngineStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="4dp"
            android:text="Engine A (ONNX Router): READY\nEngine B (llama.cpp): STANDBY\nSTT (Vosk): STANDBY\nTTS (Piper): SYSTEM FALLBACK\nHardware Control (BYD DiLink): ACTIVE"
            android:textColor="#00E5FF"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>
